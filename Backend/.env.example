PORT=8000
CORS_ORIGIN=http://localhost:5173

ACCESS_TOKEN_SECRET=replace-me
ACCESS_TOKEN_EXPIRY=1h

REFRESH_TOKEN_SECRET=replace-me
REFRESH_TOKEN_EXPIRY=7d

CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_REGION=us-east-1
S3_BUCKET_NAME=replace-me
S3_PUBLIC_BASE_URL=

NODE_ENV=development

DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Quiz settings
QUIZ_ATTEMPT_LIMIT=2

# Gemini settings
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001  # Supported by Gemini embedContent on generativelanguage.googleapis.com
# GEMINI_API_VERSION=v1beta                     # Options: v1beta, v1
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="byteLearn"

